# DIU Question MCP Server Configuration

# Base URL of OurDIU Question Bank
DIU_BASE_URL=https://ourdiu.com

# Local Storage Directory for PDFs
DIU_DATA_DIR=data

# SQLite Database File Path
DIU_DB_PATH=data/diu_questions.db

# HTTP Scraper Settings
DIU_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36
DIU_REQUEST_TIMEOUT=20.0
DIU_MAX_RETRIES=3
DIU_RETRY_DELAY=1.0
DIU_RATE_LIMIT_DELAY=0.3

# MCP Transport Configuration
# Options: stdio, sse, streamable-http
DIU_MCP_TRANSPORT=stdio
DIU_SERVER_HOST=127.0.0.1
DIU_SERVER_PORT=8000

# Logging Level: DEBUG, INFO, WARNING, ERROR
DIU_LOG_LEVEL=INFO
